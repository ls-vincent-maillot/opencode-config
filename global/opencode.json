{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"figma": {
			"type": "remote",
			"url": "https://mcp.figma.com/mcp",
			"enabled": true
		},
		"datadog": {
			"type": "local",
			"command": ["/Users/vincent.maillot/.local/bin/datadog_mcp_cli"],
			"enabled": true
		}
	},
	"enabled_providers": [
		"github-copilot",
		"anthropic",
		"google",
		"openai",
		"lmstudio"
	],
	"permission": {
		"*": "ask",
		"bash": {
			"*": "ask",
			"curl *": "allow",
			"git *": "allow",
			"head *": "allow",
			"playwright-cli *": "allow"
		},
		"edit": {
			"*": "allow"
		},
		"glob": "allow",
		"grep": "allow",
		"list": "allow",
		"lsp": "allow",
		"read": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "allow"
		},
		"skill": "allow",
		"task": "allow",
		"todoread": "allow",
		"todowrite": "allow"
	},
	"plugin": [
		"@lightspeedhq/opencode-context-progress",
		"@lightspeedhq/opencode-copilot-usage",
		"@lightspeedhq/opencode-ghostty-notifier",
		"@lightspeedhq/opencode-provider-logo",
		"@lightspeedhq/opencode-recap",
		"@lightspeedhq/opencode-subprojects",
		"@lightspeedhq/opencode-telemetry"
	],
	"share": "disabled"
}
